@using System.Globalization
@using System.Text.Json
@model DapperMegaSalesAnalytics.WebUI.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";

    var completedRateWidth = Model.Summary.CompletedRate.ToString(CultureInfo.InvariantCulture);
    var cancelledRateWidth = Model.Summary.CancelledRate.ToString(CultureInfo.InvariantCulture);
    var returnedRateWidth = Model.Summary.ReturnedRate.ToString(CultureInfo.InvariantCulture);
    var websiteRateWidth = Model.Summary.WebsiteRate.ToString(CultureInfo.InvariantCulture);
    var creditCardRateWidth = Model.Summary.CreditCardRate.ToString(CultureInfo.InvariantCulture);
}

@section Styles {
    <style>
        .dashboard-hero {
            position: relative;
            overflow: hidden;
            border-radius: 32px;
            padding: 36px;
            margin-bottom: 28px;
            background: radial-gradient(circle at 86% 14%, rgba(59,130,246,.40), transparent 28%), radial-gradient(circle at 70% 100%, rgba(6,182,212,.20), transparent 32%), linear-gradient(135deg, rgba(15,23,42,.98), rgba(7,11,20,.98));
            border: 1px solid rgba(148,163,184,.16);
            box-shadow: 0 28px 80px rgba(0,0,0,.36);
        }

            .dashboard-hero::after {
                content: "";
                position: absolute;
                width: 420px;
                height: 420px;
                right: -170px;
                bottom: -230px;
                background: rgba(37,99,235,.24);
                border-radius: 999px;
                filter: blur(12px);
            }

        .hero-kicker {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            color: #bfdbfe;
            background: rgba(37,99,235,.16);
            border: 1px solid rgba(59,130,246,.28);
            padding: 9px 13px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 950;
            margin-bottom: 18px;
        }

        .hero-title {
            color: #ffffff;
            font-size: clamp(36px, 4vw, 56px);
            font-weight: 950;
            letter-spacing: -.06em;
            margin-bottom: 12px;
        }

        .hero-desc {
            color: #94a3b8;
            max-width: 780px;
            line-height: 1.7;
            margin-bottom: 0;
        }

        .hero-side-card {
            position: relative;
            z-index: 2;
            background: rgba(15,23,42,.68);
            border: 1px solid rgba(148,163,184,.18);
            border-radius: 26px;
            padding: 24px;
            backdrop-filter: blur(18px);
            box-shadow: 0 22px 60px rgba(0,0,0,.25);
        }

        .hero-side-value {
            color: #ffffff;
            font-size: clamp(34px, 4vw, 54px);
            font-weight: 950;
            letter-spacing: -.055em;
            line-height: 1;
        }

        .hero-side-label {
            color: #94a3b8;
            font-size: 13px;
            font-weight: 850;
            margin-top: 10px;
        }

        .kpi-card {
            position: relative;
            overflow: hidden;
            height: 100%;
            border-radius: 26px;
            padding: 24px;
            background: radial-gradient(circle at top right, rgba(59,130,246,.18), transparent 34%), rgba(15,23,42,.84);
            border: 1px solid rgba(148,163,184,.16);
            box-shadow: 0 22px 60px rgba(0,0,0,.28);
        }

            .kpi-card::after {
                content: "";
                position: absolute;
                width: 130px;
                height: 130px;
                right: -54px;
                top: -54px;
                border-radius: 999px;
                background: rgba(59,130,246,.13);
            }

        .kpi-icon {
            width: 50px;
            height: 50px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(59,130,246,.16);
            border: 1px solid rgba(59,130,246,.26);
            color: #60a5fa;
            font-size: 22px;
            margin-bottom: 18px;
            position: relative;
            z-index: 2;
        }

        .kpi-label {
            color: #94a3b8;
            font-size: 13px;
            font-weight: 850;
            margin-bottom: 7px;
            position: relative;
            z-index: 2;
        }

        .kpi-value {
            color: #ffffff;
            font-size: 30px;
            font-weight: 950;
            letter-spacing: -.045em;
            position: relative;
            z-index: 2;
        }

        .kpi-note {
            color: #64748b;
            font-size: 12px;
            font-weight: 800;
            margin-top: 8px;
            position: relative;
            z-index: 2;
        }

        .analytics-card,
        .progress-card,
        .insight-card {
            height: 100%;
            border-radius: 28px;
            background: radial-gradient(circle at top right, rgba(59,130,246,.10), transparent 30%), rgba(15,23,42,.86);
            border: 1px solid rgba(148,163,184,.16);
            box-shadow: 0 24px 70px rgba(0,0,0,.30);
            overflow: hidden;
        }

        .analytics-header {
            padding: 24px 26px;
            border-bottom: 1px solid rgba(148,163,184,.14);
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 16px;
        }

        .analytics-title {
            color: #ffffff;
            font-size: 21px;
            font-weight: 950;
            letter-spacing: -.035em;
            margin: 0;
        }

        .analytics-subtitle {
            color: #94a3b8;
            font-size: 14px;
            margin-top: 6px;
            margin-bottom: 0;
        }

        .analytics-badge {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            color: #bfdbfe;
            background: rgba(37,99,235,.14);
            border: 1px solid rgba(59,130,246,.24);
            padding: 9px 12px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 950;
            white-space: nowrap;
        }

        .chart-box {
            height: 370px;
            padding: 24px 26px 26px;
        }

        .small-chart-box {
            height: 310px;
            padding: 24px 26px 26px;
        }

        .progress-card {
            padding: 26px;
        }

        .progress-item {
            margin-bottom: 22px;
        }

            .progress-item:last-child {
                margin-bottom: 0;
            }

        .progress-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
            color: #e2e8f0;
            font-size: 14px;
            font-weight: 900;
        }

        .progress {
            height: 12px;
            border-radius: 999px;
            background: rgba(148,163,184,.16);
            overflow: hidden;
        }

        .progress-bar {
            border-radius: 999px;
        }

        .progress-completed {
            background: linear-gradient(90deg, #16a34a, #86efac);
        }

        .progress-cancelled {
            background: linear-gradient(90deg, #dc2626, #fca5a5);
        }

        .progress-returned {
            background: linear-gradient(90deg, #7c3aed, #c4b5fd);
        }

        .progress-website {
            background: linear-gradient(90deg, #2563eb, #67e8f9);
        }

        .progress-cardpay {
            background: linear-gradient(90deg, #0891b2, #22d3ee);
        }

        .insight-card {
            padding: 26px;
        }

        .insight-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 18px;
            padding: 18px 0;
            border-bottom: 1px solid rgba(148,163,184,.12);
        }

            .insight-row:last-child {
                border-bottom: 0;
                padding-bottom: 0;
            }

        .insight-label {
            color: #94a3b8;
            font-size: 13px;
            font-weight: 850;
            margin-bottom: 5px;
        }

        .insight-value {
            color: #ffffff;
            font-size: 20px;
            font-weight: 950;
            letter-spacing: -.025em;
        }

        .insight-icon {
            width: 46px;
            height: 46px;
            border-radius: 17px;
            background: rgba(59,130,246,.14);
            border: 1px solid rgba(59,130,246,.22);
            color: #60a5fa;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }

        .premium-table {
            margin: 0;
            min-width: 1000px;
            color: #e2e8f0;
        }

            .premium-table thead th {
                background: rgba(5,8,22,.96);
                color: #93c5fd;
                border-color: rgba(148,163,184,.10);
                font-size: 12px;
                letter-spacing: .055em;
                text-transform: uppercase;
                padding: 16px;
                white-space: nowrap;
            }

            .premium-table tbody td {
                vertical-align: middle;
                border-color: rgba(148,163,184,.10);
                padding: 17px 16px;
                font-size: 14px;
                color: #dbe7f5;
                background: rgba(15,23,42,.58);
            }

            .premium-table tbody tr:hover td {
                background: rgba(30,41,59,.78);
            }

        .muted-small {
            color: #94a3b8;
            font-size: 12px;
            font-weight: 750;
        }

        .table-id-pill {
            display: inline-flex;
            align-items: center;
            padding: 7px 10px;
            border-radius: 999px;
            background: rgba(148,163,184,.12);
            border: 1px solid rgba(148,163,184,.22);
            color: #e2e8f0;
            font-size: 12px;
            font-weight: 950;
            white-space: nowrap;
        }

        .table-city-text {
            color: #dbeafe;
            font-weight: 900;
            font-size: 14px;
        }

        .table-total-text {
            color: #f8fafc;
            font-weight: 950;
            font-size: 15px;
            white-space: nowrap;
        }

        .table-channel-pill {
            display: inline-flex;
            align-items: center;
            padding: 7px 11px;
            border-radius: 999px;
            background: rgba(59,130,246,.14);
            border: 1px solid rgba(59,130,246,.28);
            color: #93c5fd;
            font-size: 12px;
            font-weight: 900;
            white-space: nowrap;
        }

        .table-date-text {
            color: #f8fafc;
            font-weight: 850;
            font-size: 13px;
            white-space: nowrap;
        }

        .table-qty-text {
            color: #fbbf24;
            font-size: 12px;
            font-weight: 850;
            margin-top: 3px;
        }

        .table-category-text {
            color: #67e8f9;
            font-size: 12px;
            font-weight: 800;
            margin-top: 3px;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            padding: 7px 11px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 950;
            white-space: nowrap;
            border: 1px solid transparent;
        }

        .status-completed {
            background: rgba(34,197,94,.14);
            color: #86efac;
            border-color: rgba(34,197,94,.24);
        }

        .status-pending {
            background: rgba(245,158,11,.14);
            color: #fcd34d;
            border-color: rgba(245,158,11,.24);
        }

        .status-cancelled {
            background: rgba(239,68,68,.14);
            color: #fca5a5;
            border-color: rgba(239,68,68,.24);
        }

        .status-returned {
            background: rgba(139,92,246,.14);
            color: #c4b5fd;
            border-color: rgba(139,92,246,.24);
        }

        .status-processing {
            background: rgba(6,182,212,.14);
            color: #67e8f9;
            border-color: rgba(6,182,212,.24);
        }

        .open-grid-btn {
            background: linear-gradient(135deg, #2563eb, #06b6d4);
            color: white;
            border: 0;
            border-radius: 999px;
            padding: 11px 18px;
            font-weight: 950;
            box-shadow: 0 18px 38px rgba(37,99,235,.24);
        }

            .open-grid-btn:hover {
                color: white;
                filter: brightness(1.05);
            }

        @@media (max-width: 992px) {
            .dashboard-hero {
                padding: 24px;
            }

            .chart-box,
            .small-chart-box {
                height: 290px;
            }
        }
    </style>
}

<div class="dashboard-hero">
    <div class="row align-items-end g-4 position-relative" style="z-index: 2;">
        <div class="col-xl-8">
            <div class="hero-kicker">
                <i class="bi bi-lightning-charge-fill"></i>
                Dapper analytics over 2M+ sales records
            </div>

            <h1 class="hero-title">Mega Sales Dashboard</h1>

            <p class="hero-desc">
                Real-time business intelligence dashboard powered by SQL Server aggregate queries,
                Dapper repositories, layered architecture, indexed analytics and high-volume transaction data.
            </p>
        </div>

        <div class="col-xl-4">
            <div class="hero-side-card">
                <div class="hero-side-value">@Model.Summary.TotalTransactions.ToString("N0")</div>
                <div class="hero-side-label">Total active transactions</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-cash-stack"></i>
            </div>
            <div class="kpi-label">Total Revenue</div>
            <div class="kpi-value">@Model.Summary.TotalRevenue.ToString("C0")</div>
            <div class="kpi-note">Completed orders only</div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-bag-check"></i>
            </div>
            <div class="kpi-label">Total Orders</div>
            <div class="kpi-value">@Model.Summary.TotalTransactions.ToString("N0")</div>
            <div class="kpi-note">Soft-deleted rows excluded</div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-people"></i>
            </div>
            <div class="kpi-label">Total Customers</div>
            <div class="kpi-value">@Model.Summary.TotalCustomers.ToString("N0")</div>
            <div class="kpi-note">Distinct customer emails</div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div class="kpi-icon">
                <i class="bi bi-graph-up-arrow"></i>
            </div>
            <div class="kpi-label">Average Order Value</div>
            <div class="kpi-value">@Model.Summary.AverageOrderValue.ToString("C0")</div>
            <div class="kpi-note">Completed order average</div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-xl-8">
        <div class="analytics-card">
            <div class="analytics-header">
                <div>
                    <h3 class="analytics-title">Monthly Revenue Trend</h3>
                    <p class="analytics-subtitle">Last 12 months completed sales revenue.</p>
                </div>
                <div class="analytics-badge">
                    <i class="bi bi-activity"></i>
                    Revenue
                </div>
            </div>

            <div class="chart-box">
                <canvas id="monthlyRevenueChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="progress-card">
            <div class="mb-4">
                <h3 class="analytics-title">Conversion Health</h3>
                <p class="analytics-subtitle">Operational ratios calculated from SQL aggregates.</p>
            </div>

            <div class="progress-item">
                <div class="progress-meta">
                    <span>Completed Orders</span>
                    <span>@Model.Summary.CompletedRate.ToString("N2")%</span>
                </div>
                <div class="progress">
                    <div class="progress-bar progress-completed" style="width:@completedRateWidth%"></div>
                </div>
            </div>

            <div class="progress-item">
                <div class="progress-meta">
                    <span>Cancelled Orders</span>
                    <span>@Model.Summary.CancelledRate.ToString("N2")%</span>
                </div>
                <div class="progress">
                    <div class="progress-bar progress-cancelled" style="width:@cancelledRateWidth%"></div>
                </div>
            </div>

            <div class="progress-item">
                <div class="progress-meta">
                    <span>Returned Orders</span>
                    <span>@Model.Summary.ReturnedRate.ToString("N2")%</span>
                </div>
                <div class="progress">
                    <div class="progress-bar progress-returned" style="width:@returnedRateWidth%"></div>
                </div>
            </div>

            <div class="progress-item">
                <div class="progress-meta">
                    <span>Website Channel</span>
                    <span>@Model.Summary.WebsiteRate.ToString("N2")%</span>
                </div>
                <div class="progress">
                    <div class="progress-bar progress-website" style="width:@websiteRateWidth%"></div>
                </div>
            </div>

            <div class="progress-item">
                <div class="progress-meta">
                    <span>Credit Card Payment</span>
                    <span>@Model.Summary.CreditCardRate.ToString("N2")%</span>
                </div>
                <div class="progress">
                    <div class="progress-bar progress-cardpay" style="width:@creditCardRateWidth%"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-xl-5">
        <div class="analytics-card">
            <div class="analytics-header">
                <div>
                    <h3 class="analytics-title">Revenue by Category</h3>
                    <p class="analytics-subtitle">Top categories ranked by completed revenue.</p>
                </div>
                <div class="analytics-badge">
                    <i class="bi bi-grid-fill"></i>
                    Category
                </div>
            </div>

            <div class="small-chart-box">
                <canvas id="categoryRevenueChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-xl-3">
        <div class="analytics-card">
            <div class="analytics-header">
                <div>
                    <h3 class="analytics-title">Order Status</h3>
                    <p class="analytics-subtitle">Distribution by status.</p>
                </div>
            </div>

            <div class="small-chart-box">
                <canvas id="orderStatusChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="insight-card">
            <div class="mb-3">
                <h3 class="analytics-title">Executive Insights</h3>
                <p class="analytics-subtitle">Top performing business dimensions.</p>
            </div>

            <div class="insight-row">
                <div>
                    <div class="insight-label">Top City</div>
                    <div class="insight-value">@Model.Summary.TopCity</div>
                </div>
                <div class="insight-icon">
                    <i class="bi bi-geo-alt-fill"></i>
                </div>
            </div>

            <div class="insight-row">
                <div>
                    <div class="insight-label">Top Category</div>
                    <div class="insight-value">@Model.Summary.TopCategory</div>
                </div>
                <div class="insight-icon">
                    <i class="bi bi-box-seam-fill"></i>
                </div>
            </div>

            <div class="insight-row">
                <div>
                    <div class="insight-label">Top Sales Channel</div>
                    <div class="insight-value">@Model.Summary.TopSalesChannel</div>
                </div>
                <div class="insight-icon">
                    <i class="bi bi-shop-window"></i>
                </div>
            </div>

            <div class="insight-row">
                <div>
                    <div class="insight-label">Dataset Scale</div>
                    <div class="insight-value">@Model.Summary.TotalTransactions.ToString("N0") Rows</div>
                </div>
                <div class="insight-icon">
                    <i class="bi bi-database-fill-check"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-xl-4">
        <div class="analytics-card">
            <div class="analytics-header">
                <div>
                    <h3 class="analytics-title">Payment Methods</h3>
                    <p class="analytics-subtitle">Horizontal comparison by payment type.</p>
                </div>
                <div class="analytics-badge">
                    <i class="bi bi-credit-card-2-front"></i>
                    Bar
                </div>
            </div>

            <div class="small-chart-box">
                <canvas id="paymentMethodChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="analytics-card">
            <div class="analytics-header">
                <div>
                    <h3 class="analytics-title">Sales Channels</h3>
                    <p class="analytics-subtitle">Polar area distribution by channel.</p>
                </div>
                <div class="analytics-badge">
                    <i class="bi bi-pie-chart-fill"></i>
                    Polar
                </div>
            </div>

            <div class="small-chart-box">
                <canvas id="salesChannelChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="analytics-card">
            <div class="analytics-header">
                <div>
                    <h3 class="analytics-title">Top Cities</h3>
                    <p class="analytics-subtitle">Revenue ranking by location.</p>
                </div>
                <div class="analytics-badge">
                    <i class="bi bi-geo-alt"></i>
                    Cities
                </div>
            </div>

            <div class="small-chart-box">
                <canvas id="topCitiesChart"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="analytics-card">
    <div class="analytics-header">
        <div>
            <h3 class="analytics-title">High Value Transactions</h3>
            <p class="analytics-subtitle">Top revenue transactions from the active dataset.</p>
        </div>

        <a asp-controller="Sales" asp-action="Index" class="open-grid-btn">
            Open Data Grid
        </a>
    </div>

    <div class="table-responsive">
        <table class="table premium-table align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Order</th>
                    <th>Customer</th>
                    <th>City</th>
                    <th>Product</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Channel</th>
                    <th>Date</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model.RecentHighValueTransactions)
                {
                    var statusClass = item.OrderStatus switch
                    {
                        "Completed" => "status-completed",
                        "Pending" => "status-pending",
                        "Cancelled" => "status-cancelled",
                        "Returned" => "status-returned",
                        _ => "status-processing"
                    };

                    <tr>
                        <td>
                            <span class="table-id-pill">#@item.SalesTransactionId</span>
                        </td>

                        <td>
                            <div class="fw-bold text-white">@item.OrderNumber</div>
                            <div class="table-qty-text">Qty: @item.Quantity</div>
                        </td>

                        <td>
                            <div class="fw-bold text-white">@item.CustomerFullName</div>
                            <div class="muted-small">@item.CustomerEmail</div>
                        </td>

                        <td>
                            <div class="table-city-text">@item.City</div>
                        </td>

                        <td>
                            <div class="fw-bold text-white">@item.ProductName</div>
                            <div class="table-category-text">@item.ProductCategory</div>
                        </td>

                        <td>
                            <div class="table-total-text">@item.TotalPrice.ToString("C0")</div>
                        </td>

                        <td>
                            <span class="status-badge @statusClass">@item.OrderStatus</span>
                        </td>

                        <td>
                            <span class="table-channel-pill">@item.SalesChannel</span>
                        </td>

                        <td>
                            <div class="table-date-text">@item.OrderDate.ToString("dd MMM yyyy")</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    @{
        var monthlyRevenueJson = JsonSerializer.Serialize(Model.MonthlyRevenue.Select(x => new
        {
            label = x.Label,
            value = x.Value,
            count = x.Count
        }));

        var categoryRevenueJson = JsonSerializer.Serialize(Model.CategoryRevenue.Select(x => new
        {
            label = x.Label,
            value = x.Value,
            count = x.Count
        }));

        var orderStatusJson = JsonSerializer.Serialize(Model.OrderStatusDistribution.Select(x => new
        {
            label = x.Label,
            value = x.Value,
            count = x.Count
        }));

        var paymentMethodJson = JsonSerializer.Serialize(Model.PaymentMethodDistribution.Select(x => new
        {
            label = x.Label,
            value = x.Value,
            count = x.Count
        }));

        var salesChannelJson = JsonSerializer.Serialize(Model.SalesChannelDistribution.Select(x => new
        {
            label = x.Label,
            value = x.Value,
            count = x.Count
        }));

        var topCitiesJson = JsonSerializer.Serialize(Model.TopCities.Select(x => new
        {
            label = x.Label,
            value = x.Value,
            count = x.Count
        }));
    }

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const monthlyRevenue = @Html.Raw(monthlyRevenueJson);
        const categoryRevenue = @Html.Raw(categoryRevenueJson);
        const orderStatus = @Html.Raw(orderStatusJson);
        const paymentMethods = @Html.Raw(paymentMethodJson);
        const salesChannels = @Html.Raw(salesChannelJson);
        const topCities = @Html.Raw(topCitiesJson);

        const moneyFormatter = new Intl.NumberFormat('tr-TR', {
            style: 'currency',
            currency: 'TRY',
            maximumFractionDigits: 0
        });

        const compactFormatter = new Intl.NumberFormat('tr-TR', {
            notation: 'compact',
            maximumFractionDigits: 1
        });

        Chart.defaults.font.family = 'Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif';
        Chart.defaults.color = '#94a3b8';

        function createLineGradient(canvasId) {
            const canvas = document.getElementById(canvasId);
            const ctx = canvas.getContext('2d');
            const gradient = ctx.createLinearGradient(0, 0, 0, 340);

            gradient.addColorStop(0, 'rgba(59, 130, 246, .34)');
            gradient.addColorStop(1, 'rgba(59, 130, 246, 0)');

            return gradient;
        }

        function buildDoughnutChart(canvasId, data) {
            new Chart(document.getElementById(canvasId), {
                type: 'doughnut',
                data: {
                    labels: data.map(x => x.label),
                    datasets: [{
                        data: data.map(x => x.count),
                        borderWidth: 0,
                        hoverOffset: 8,
                        backgroundColor: [
                            'rgba(59,130,246,.88)',
                            'rgba(6,182,212,.82)',
                            'rgba(34,197,94,.82)',
                            'rgba(245,158,11,.82)',
                            'rgba(139,92,246,.82)',
                            'rgba(239,68,68,.82)'
                        ]
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '68%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                color: '#cbd5e1',
                                usePointStyle: true,
                                boxWidth: 8,
                                padding: 16,
                                font: {
                                    weight: '800'
                                }
                            }
                        },
                        tooltip: {
                            backgroundColor: 'rgba(15,23,42,.96)',
                            titleColor: '#ffffff',
                            bodyColor: '#cbd5e1',
                            borderColor: 'rgba(148,163,184,.18)',
                            borderWidth: 1,
                            callbacks: {
                                label: function (context) {
                                    return `${context.label}: ${compactFormatter.format(context.raw)} orders`;
                                }
                            }
                        }
                    }
                }
            });
        }

        function buildHorizontalCountBarChart(canvasId, data) {
            new Chart(document.getElementById(canvasId), {
                type: 'bar',
                data: {
                    labels: data.map(x => x.label),
                    datasets: [{
                        label: 'Orders',
                        data: data.map(x => x.count),
                        borderRadius: 12,
                        borderSkipped: false,
                        backgroundColor: [
                            'rgba(59,130,246,.88)',
                            'rgba(6,182,212,.82)',
                            'rgba(34,197,94,.82)',
                            'rgba(245,158,11,.82)',
                            'rgba(139,92,246,.82)'
                        ]
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            backgroundColor: 'rgba(15,23,42,.96)',
                            titleColor: '#ffffff',
                            bodyColor: '#cbd5e1',
                            borderColor: 'rgba(148,163,184,.18)',
                            borderWidth: 1,
                            callbacks: {
                                label: function (context) {
                                    return `Orders: ${compactFormatter.format(context.raw)}`;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            beginAtZero: true,
                            ticks: {
                                color: '#94a3b8',
                                callback: function (value) {
                                    return compactFormatter.format(value);
                                }
                            },
                            grid: {
                                color: 'rgba(148,163,184,.10)'
                            }
                        },
                        y: {
                            grid: {
                                display: false
                            },
                            ticks: {
                                color: '#cbd5e1',
                                font: {
                                    weight: '800'
                                }
                            }
                        }
                    }
                }
            });
        }

        function buildPolarAreaChart(canvasId, data) {
            new Chart(document.getElementById(canvasId), {
                type: 'polarArea',
                data: {
                    labels: data.map(x => x.label),
                    datasets: [{
                        data: data.map(x => x.count),
                        borderWidth: 1,
                        borderColor: 'rgba(15,23,42,.85)',
                        backgroundColor: [
                            'rgba(59,130,246,.82)',
                            'rgba(6,182,212,.78)',
                            'rgba(34,197,94,.78)',
                            'rgba(245,158,11,.78)',
                            'rgba(139,92,246,.78)',
                            'rgba(239,68,68,.78)'
                        ]
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        r: {
                            ticks: {
                                display: false
                            },
                            grid: {
                                color: 'rgba(148,163,184,.12)'
                            },
                            angleLines: {
                                color: 'rgba(148,163,184,.10)'
                            }
                        }
                    },
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                color: '#cbd5e1',
                                usePointStyle: true,
                                boxWidth: 8,
                                padding: 14,
                                font: {
                                    weight: '800'
                                }
                            }
                        },
                        tooltip: {
                            backgroundColor: 'rgba(15,23,42,.96)',
                            titleColor: '#ffffff',
                            bodyColor: '#cbd5e1',
                            borderColor: 'rgba(148,163,184,.18)',
                            borderWidth: 1,
                            callbacks: {
                                label: function (context) {
                                    return `${context.label}: ${compactFormatter.format(context.raw)} orders`;
                                }
                            }
                        }
                    }
                }
            });
        }

        new Chart(document.getElementById('monthlyRevenueChart'), {
            type: 'line',
            data: {
                labels: monthlyRevenue.map(x => x.label),
                datasets: [{
                    label: 'Revenue',
                    data: monthlyRevenue.map(x => x.value),
                    fill: true,
                    backgroundColor: createLineGradient('monthlyRevenueChart'),
                    borderColor: '#3b82f6',
                    borderWidth: 3,
                    pointBackgroundColor: '#06b6d4',
                    pointBorderColor: '#ffffff',
                    pointBorderWidth: 2,
                    pointRadius: 4,
                    pointHoverRadius: 7,
                    tension: .38
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    mode: 'index',
                    intersect: false
                },
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        backgroundColor: 'rgba(15,23,42,.96)',
                        titleColor: '#ffffff',
                        bodyColor: '#cbd5e1',
                        borderColor: 'rgba(148,163,184,.18)',
                        borderWidth: 1,
                        callbacks: {
                            label: function (context) {
                                return `Revenue: ${moneyFormatter.format(context.raw)}`;
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: {
                            display: false
                        },
                        ticks: {
                            color: '#94a3b8',
                            font: {
                                weight: '800'
                            }
                        }
                    },
                    y: {
                        beginAtZero: true,
                        ticks: {
                            color: '#94a3b8',
                            callback: function (value) {
                                return compactFormatter.format(value);
                            }
                        },
                        grid: {
                            color: 'rgba(148,163,184,.10)'
                        }
                    }
                }
            }
        });

        new Chart(document.getElementById('categoryRevenueChart'), {
            type: 'bar',
            data: {
                labels: categoryRevenue.map(x => x.label),
                datasets: [{
                    label: 'Revenue',
                    data: categoryRevenue.map(x => x.value),
                    borderRadius: 12,
                    borderSkipped: false,
                    backgroundColor: 'rgba(59,130,246,.86)'
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        backgroundColor: 'rgba(15,23,42,.96)',
                        titleColor: '#ffffff',
                        bodyColor: '#cbd5e1',
                        borderColor: 'rgba(148,163,184,.18)',
                        borderWidth: 1,
                        callbacks: {
                            label: function (context) {
                                return moneyFormatter.format(context.raw);
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        ticks: {
                            color: '#94a3b8',
                            callback: function (value) {
                                return compactFormatter.format(value);
                            }
                        },
                        grid: {
                            color: 'rgba(148,163,184,.10)'
                        }
                    },
                    y: {
                        grid: {
                            display: false
                        },
                        ticks: {
                            color: '#cbd5e1',
                            font: {
                                weight: '800'
                            }
                        }
                    }
                }
            }
        });

        buildDoughnutChart('orderStatusChart', orderStatus);
        buildHorizontalCountBarChart('paymentMethodChart', paymentMethods);
        buildPolarAreaChart('salesChannelChart', salesChannels);

        new Chart(document.getElementById('topCitiesChart'), {
            type: 'bar',
            data: {
                labels: topCities.map(x => x.label),
                datasets: [{
                    label: 'Revenue',
                    data: topCities.map(x => x.value),
                    borderRadius: 12,
                    borderSkipped: false,
                    backgroundColor: 'rgba(6,182,212,.82)'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        backgroundColor: 'rgba(15,23,42,.96)',
                        titleColor: '#ffffff',
                        bodyColor: '#cbd5e1',
                        borderColor: 'rgba(148,163,184,.18)',
                        borderWidth: 1,
                        callbacks: {
                            label: function (context) {
                                return moneyFormatter.format(context.raw);
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: {
                            display: false
                        },
                        ticks: {
                            color: '#cbd5e1',
                            font: {
                                weight: '800'
                            }
                        }
                    },
                    y: {
                        ticks: {
                            color: '#94a3b8',
                            callback: function (value) {
                                return compactFormatter.format(value);
                            }
                        },
                        grid: {
                            color: 'rgba(148,163,184,.10)'
                        }
                    }
                }
            }
        });
    </script>
}