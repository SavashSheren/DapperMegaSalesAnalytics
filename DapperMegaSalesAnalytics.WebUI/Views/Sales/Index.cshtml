        }

        .customer-name {
            font-weight: 900;
            color: #0f172a;
        }

        .customer-email {
            color: #64748b;
            font-size: 12px;
            margin-top: 3px;
        }

        .product-name {
            font-weight: 800;
            color: #111827;
        }

        .category-text {
            color: #64748b;
            font-size: 13px;
            margin-top: 2px;
        }

        .money-text {
            font-weight: 900;
            color: #0f172a;
