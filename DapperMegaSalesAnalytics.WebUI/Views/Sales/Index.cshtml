@using System.Globalization
@model DapperMegaSalesAnalytics.WebUI.Models.SalesTransactionListViewModel

@{
    ViewData["Title"] = "Sales Transactions";

    var startPage = Math.Max(1, Model.CurrentPage - 2);
    var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);

    var statuses = new List<string> { "Completed", "Pending", "Cancelled", "Returned", "Processing" };
    var payments = new List<string> { "Credit Card", "Bank Transfer", "Cash", "PayPal" };
    var channels = new List<string> { "Website", "Mobile App", "Marketplace", "Store" };

    string BuildFilterUrl(int page, int? editId = null)
    {
        return Url.Action("Index", "Sales", new
        {
            page,
            pageSize = Model.Filter.PageSize,
            searchId = Model.Filter.SearchId,
            searchTerm = Model.Filter.SearchTerm,
            city = Model.Filter.City,
            category = Model.Filter.Category,
            status = Model.Filter.Status,
            paymentMethod = Model.Filter.PaymentMethod,
            salesChannel = Model.Filter.SalesChannel,
            startDate = Model.Filter.StartDate?.ToString("yyyy-MM-dd"),
            endDate = Model.Filter.EndDate?.ToString("yyyy-MM-dd"),
            minPrice = Model.Filter.MinPrice?.ToString(CultureInfo.InvariantCulture),
            maxPrice = Model.Filter.MaxPrice?.ToString(CultureInfo.InvariantCulture),
            editId
        }) ?? "/Sales/Index";
    }
}

@section Styles {
    <style>
        .sales-hero {
            position: relative;
            overflow: hidden;
            background: radial-gradient(circle at top right, rgba(37,99,235,.35), transparent 32%), linear-gradient(135deg, #0f172a, #111827);
            color: white;
            border-radius: 28px;
            padding: 34px;
            margin-bottom: 26px;
            box-shadow: 0 22px 50px rgba(15, 23, 42, .18);
        }

            .sales-hero::after {
                content: "";
                position: absolute;
                width: 320px;
                height: 320px;
                right: -120px;
                bottom: -170px;
                background: rgba(59, 130, 246, .28);
                border-radius: 999px;
                filter: blur(8px);
            }

        .hero-kicker {
            display: inline-flex;
            gap: 8px;
            align-items: center;
            background: rgba(255,255,255,.10);
            border: 1px solid rgba(255,255,255,.16);
            color: #cbd5e1;
            padding: 8px 12px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 18px;
        }

        .hero-title {
            font-size: clamp(30px, 4vw, 46px);
            font-weight: 900;
            letter-spacing: -.04em;
            margin-bottom: 10px;
        }

        .hero-desc {
            color: #cbd5e1;
            max-width: 720px;
            margin-bottom: 0;
        }

        .hero-number {
            font-size: clamp(32px, 4vw, 50px);
            font-weight: 900;
            letter-spacing: -.04em;
