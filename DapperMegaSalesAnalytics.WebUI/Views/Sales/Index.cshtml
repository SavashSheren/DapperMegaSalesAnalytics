@using System.Globalization
@model DapperMegaSalesAnalytics.WebUI.Models.SalesTransactionListViewModel

@{
    ViewData["Title"] = "Sales Transactions";

    var startPage = Math.Max(1, Model.CurrentPage - 2);
    var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);

    var statuses = new List<string> { "Completed", "Pending", "Cancelled", "Returned", "Processing" };
    var payments = new List<string> { "Credit Card", "Bank Transfer", "Cash", "PayPal" };
    var channels = new List<string> { "Website", "Mobile App", "Marketplace", "Store" };

    string BuildFilterUrl(int page, int? editId = null)
    {
        return Url.Action("Index", "Sales", new
        {
            page,
            pageSize = Model.Filter.PageSize,
            searchId = Model.Filter.SearchId,
            searchTerm = Model.Filter.SearchTerm,
            city = Model.Filter.City,
            category = Model.Filter.Category,
            status = Model.Filter.Status,
            paymentMethod = Model.Filter.PaymentMethod,
            salesChannel = Model.Filter.SalesChannel,
            startDate = Model.Filter.StartDate?.ToString("yyyy-MM-dd"),
            endDate = Model.Filter.EndDate?.ToString("yyyy-MM-dd"),
            minPrice = Model.Filter.MinPrice?.ToString(CultureInfo.InvariantCulture),
            maxPrice = Model.Filter.MaxPrice?.ToString(CultureInfo.InvariantCulture),
            editId
        }) ?? "/Sales/Index";
    }
}

@section Styles {
    <style>
        .sales-hero {
            position: relative;
            overflow: hidden;
            border-radius: 30px;
            padding: 34px;
            margin-bottom: 26px;
            background: radial-gradient(circle at 82% 14%, rgba(59,130,246,.38), transparent 28%), radial-gradient(circle at 68% 100%, rgba(6,182,212,.18), transparent 30%), linear-gradient(135deg, rgba(15,23,42,.96), rgba(7,11,20,.98));
            border: 1px solid rgba(148,163,184,.16);
            box-shadow: 0 26px 70px rgba(0,0,0,.34);
        }

            .sales-hero::after {
                content: "";
                position: absolute;
                width: 360px;
                height: 360px;
                right: -140px;
                bottom: -200px;
                background: rgba(37,99,235,.22);
                border-radius: 999px;
                filter: blur(10px);
            }

        .hero-kicker {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            color: #bfdbfe;
            background: rgba(37,99,235,.16);
            border: 1px solid rgba(59,130,246,.28);
            padding: 9px 13px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 900;
            margin-bottom: 18px;
        }

        .hero-title {
            color: #ffffff;
            font-size: clamp(34px, 4vw, 52px);
            font-weight: 950;
            letter-spacing: -.055em;
            margin-bottom: 12px;
        }

        .hero-desc {
            color: #94a3b8;
            max-width: 760px;
            line-height: 1.7;
            margin-bottom: 0;
        }

        .hero-number {
            color: #ffffff;
            font-size: clamp(34px, 4vw, 54px);
            font-weight: 950;
            letter-spacing: -.055em;
            line-height: 1;
        }

        .hero-label {
            color: #94a3b8;
            font-size: 13px;
            font-weight: 800;
            margin-top: 9px;
        }

        .glass-panel {
            background: rgba(15,23,42,.76);
            border: 1px solid rgba(148,163,184,.16);
            box-shadow: 0 24px 70px rgba(0,0,0,.30);
            backdrop-filter: blur(18px);
        }

        .mini-stat {
            position: relative;
            overflow: hidden;
            height: 100%;
            border-radius: 24px;
            padding: 22px;
            background: radial-gradient(circle at top right, rgba(59,130,246,.18), transparent 35%), rgba(15,23,42,.82);
            border: 1px solid rgba(148,163,184,.16);
            box-shadow: 0 20px 50px rgba(0,0,0,.24);
        }

        .mini-stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(59,130,246,.16);
            border: 1px solid rgba(59,130,246,.24);
            color: #60a5fa;
            font-size: 21px;
            margin-bottom: 16px;
        }

        .mini-stat-label {
            color: #94a3b8;
            font-size: 13px;
            font-weight: 800;
            margin-bottom: 5px;
        }

        .mini-stat-value {
            color: #ffffff;
            font-size: 30px;
            font-weight: 950;
            letter-spacing: -.04em;
        }

        .edit-card,
        .advanced-filter-card,
        .panel-card {
            border-radius: 28px;
            background: radial-gradient(circle at top right, rgba(59,130,246,.10), transparent 30%), rgba(15,23,42,.86);
            border: 1px solid rgba(148,163,184,.16);
            box-shadow: 0 24px 70px rgba(0,0,0,.30);
            overflow: hidden;
        }

        .edit-card,
        .advanced-filter-card {
            margin-bottom: 26px;
        }

        .edit-card-header,
        .panel-header {
            padding: 24px 26px;
            border-bottom: 1px solid rgba(148,163,184,.14);
        }

        .edit-card-header {
            background: linear-gradient(135deg, rgba(37,99,235,.15), rgba(15,23,42,.55));
        }

        .edit-title,
        .filter-title,
        .panel-title {
            color: #ffffff;
            font-size: 21px;
            font-weight: 950;
            letter-spacing: -.035em;
            margin-bottom: 6px;
        }

        .edit-subtitle,
        .filter-subtitle,
        .panel-subtitle {
            color: #94a3b8;
            font-size: 14px;
            margin-bottom: 0;
        }

        .edit-grid,
        .advanced-filter-inner {
            padding: 26px;
        }

        .form-label {
            color: #94a3b8;
            font-size: 12px;
            font-weight: 950;
            text-transform: uppercase;
            letter-spacing: .06em;
            margin-bottom: 8px;
        }

        .btn-dark-soft {
            background: linear-gradient(135deg, #2563eb, #06b6d4);
            color: white;
            border: 0;
            border-radius: 15px;
            min-height: 44px;
            padding: 0 20px;
            font-weight: 950;
            box-shadow: 0 18px 38px rgba(37,99,235,.24);
        }

            .btn-dark-soft:hover {
                color: white;
                filter: brightness(1.05);
                transform: translateY(-1px);
            }

        .btn-reset {
            border-radius: 15px;
            min-height: 44px;
            padding: 0 18px;
            background: rgba(15,23,42,.62);
            border: 1px solid rgba(148,163,184,.22);
            color: #cbd5e1;
            font-weight: 900;
        }

            .btn-reset:hover {
                color: white;
                background: rgba(30,41,59,.82);
                border-color: rgba(59,130,246,.35);
            }

        .filter-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            flex-wrap: wrap;
        }

        .active-filter-strip {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 18px;
        }

        .filter-chip {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: #bfdbfe;
            background: rgba(37,99,235,.14);
            border: 1px solid rgba(59,130,246,.24);
            padding: 8px 11px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 900;
        }

        .premium-table {
            margin: 0;
            min-width: 1180px;
            color: #e2e8f0;
        }

            .premium-table thead th {
                background: rgba(5,8,22,.96);
                color: #93c5fd;
                border-color: rgba(148,163,184,.10);
                font-size: 12px;
                letter-spacing: .055em;
                text-transform: uppercase;
                padding: 16px;
                white-space: nowrap;
            }

            .premium-table tbody td {
                vertical-align: middle;
                border-color: rgba(148,163,184,.10);
                padding: 17px 16px;
                font-size: 14px;
                background: rgba(15,23,42,.52);
            }

            .premium-table tbody tr {
                transition: .18s ease;
            }

                .premium-table tbody tr:hover td {
                    background: rgba(30,41,59,.78);
                }

        .id-pill {
            background: rgba(148,163,184,.10);
            color: #e2e8f0;
            border: 1px solid rgba(148,163,184,.18);
            padding: 7px 10px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 950;
        }

        .customer-name,
        .product-name {
            color: #ffffff;
            font-weight: 950;
        }

        .customer-email,
        .category-text,
        .muted-line {
            color: #94a3b8;
            font-size: 12px;
            margin-top: 3px;
        }

        .money-text {
            color: #ffffff;
            font-weight: 950;
            white-space: nowrap;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            padding: 7px 11px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 950;
            white-space: nowrap;
            border: 1px solid transparent;
        }

        .status-completed {
            background: rgba(34,197,94,.14);
            color: #86efac;
            border-color: rgba(34,197,94,.24);
        }

        .status-pending {
            background: rgba(245,158,11,.14);
            color: #fcd34d;
            border-color: rgba(245,158,11,.24);
        }

        .status-cancelled {
            background: rgba(239,68,68,.14);
            color: #fca5a5;
            border-color: rgba(239,68,68,.24);
        }

        .status-returned {
            background: rgba(139,92,246,.14);
            color: #c4b5fd;
            border-color: rgba(139,92,246,.24);
        }

        .status-processing {
            background: rgba(6,182,212,.14);
            color: #67e8f9;
            border-color: rgba(6,182,212,.24);
        }

        .action-group {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
        }

        .btn-table {
            border-radius: 13px;
            font-size: 12px;
            font-weight: 950;
            padding: 8px 11px;
        }

        .btn-outline-primary.btn-table {
            color: #93c5fd;
            border-color: rgba(59,130,246,.45);
            background: rgba(59,130,246,.10);
        }

            .btn-outline-primary.btn-table:hover {
                color: white;
                background: rgba(59,130,246,.32);
            }

        .btn-outline-danger.btn-table {
            color: #fca5a5;
            border-color: rgba(239,68,68,.42);
            background: rgba(239,68,68,.10);
        }

            .btn-outline-danger.btn-table:hover {
                color: white;
                background: rgba(239,68,68,.32);
            }

        .pagination .page-link {
            border: 1px solid rgba(148,163,184,.14);
            background: rgba(15,23,42,.72);
            color: #cbd5e1;
            font-weight: 900;
            border-radius: 13px;
            margin: 0 3px;
            min-width: 42px;
            text-align: center;
        }

            .pagination .page-link:hover {
                background: rgba(59,130,246,.18);
                color: white;
                border-color: rgba(59,130,246,.35);
            }

        .pagination .active .page-link {
            background: linear-gradient(135deg, #2563eb, #06b6d4);
            color: white;
            border-color: transparent;
            box-shadow: 0 12px 28px rgba(37,99,235,.25);
        }

        .pagination .disabled .page-link {
            color: #475569;
            background: rgba(15,23,42,.40);
        }

        .footer-meta {
            color: #94a3b8;
            font-size: 14px;
            font-weight: 800;
        }

        .empty-state {
            padding: 76px 20px;
            text-align: center;
            color: #94a3b8;
        }

        .empty-icon {
            width: 74px;
            height: 74px;
            border-radius: 24px;
            background: rgba(148,163,184,.10);
            border: 1px solid rgba(148,163,184,.16);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            color: #64748b;
            margin-bottom: 18px;
        }

        .matching-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #bfdbfe;
            background: rgba(37,99,235,.14);
            border: 1px solid rgba(59,130,246,.24);
            padding: 10px 14px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 950;
        }

        @@media (max-width: 992px) {
            .sales-hero,
            .edit-grid,
            .advanced-filter-inner {
                padding: 22px;
            }

            .action-group {
                justify-content: flex-start;
                flex-wrap: wrap;
            }
        }
    </style>
}

<div class="sales-hero">
    <div class="row align-items-end g-4 position-relative" style="z-index: 2;">
        <div class="col-xl-8">
            <div class="hero-kicker">
                <i class="bi bi-database-check"></i>
                Dapper server-side data grid
            </div>
            <h1 class="hero-title">Sales Transactions</h1>
            <p class="hero-desc">
                Manage 2M+ sales records with SQL Server, Dapper, dynamic filters, soft delete,
                update flow and high-performance pagination.
            </p>
        </div>

        <div class="col-xl-4 text-xl-end">
            <div class="hero-number">@Model.TotalCount.ToString("N0")</div>
            <div class="hero-label">Filtered active records</div>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert rounded-4 shadow-sm mb-4">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @Model.Message
    </div>
}

<div class="row g-4 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="mini-stat">
            <div class="mini-stat-icon">
                <i class="bi bi-file-earmark-bar-graph"></i>
            </div>
            <div class="mini-stat-label">Current Page</div>
            <div class="mini-stat-value">@Model.CurrentPage.ToString("N0")</div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="mini-stat">
            <div class="mini-stat-icon">
                <i class="bi bi-list-ol"></i>
            </div>
            <div class="mini-stat-label">Page Size</div>
            <div class="mini-stat-value">@Model.PageSize</div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="mini-stat">
            <div class="mini-stat-icon">
                <i class="bi bi-layers"></i>
            </div>
            <div class="mini-stat-label">Total Pages</div>
            <div class="mini-stat-value">@Model.TotalPages.ToString("N0")</div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="mini-stat">
            <div class="mini-stat-icon">
                <i class="bi bi-lightning-charge"></i>
            </div>
            <div class="mini-stat-label">Loaded Rows</div>
            <div class="mini-stat-value">@Model.Transactions.Count</div>
        </div>
    </div>
</div>

@if (Model.EditTransaction is not null)
{
    <div class="edit-card">
        <div class="edit-card-header">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                <div>
                    <h4 class="edit-title">Update Transaction</h4>
                    <p class="edit-subtitle">
                        Editing transaction <strong>#@Model.EditTransaction.SalesTransactionId</strong>.
                        Total price is recalculated on save.
                    </p>
                </div>

                <a href="@BuildFilterUrl(Model.CurrentPage)" class="btn btn-reset">
                    <i class="bi bi-x-lg me-1"></i>
                    Close
                </a>
            </div>
        </div>

        <form asp-action="Update" method="post" class="edit-grid">
            <input type="hidden" name="SalesTransactionId" value="@Model.EditTransaction.SalesTransactionId" />

            <div class="row g-3">
                <div class="col-xl-3 col-md-6">
                    <label class="form-label">Customer</label>
                    <input class="form-control" name="CustomerFullName" value="@Model.EditTransaction.CustomerFullName" />
                </div>

                <div class="col-xl-3 col-md-6">
                    <label class="form-label">Email</label>
                    <input class="form-control" name="CustomerEmail" value="@Model.EditTransaction.CustomerEmail" />
                </div>

                <div class="col-xl-2 col-md-4">
                    <label class="form-label">City</label>
                    <input class="form-control" name="City" value="@Model.EditTransaction.City" />
                </div>

                <div class="col-xl-2 col-md-4">
                    <label class="form-label">Product</label>
                    <input class="form-control" name="ProductName" value="@Model.EditTransaction.ProductName" />
                </div>

                <div class="col-xl-2 col-md-4">
                    <label class="form-label">Category</label>
                    <input class="form-control" name="ProductCategory" value="@Model.EditTransaction.ProductCategory" />
                </div>

                <div class="col-xl-2 col-md-4">
                    <label class="form-label">Quantity</label>
                    <input class="form-control" type="number" name="Quantity" value="@Model.EditTransaction.Quantity" />
                </div>

                <div class="col-xl-2 col-md-4">
                    <label class="form-label">Unit Price</label>
                    <input class="form-control" type="number" step="0.01" name="UnitPrice" value="@Model.EditTransaction.UnitPrice.ToString(CultureInfo.InvariantCulture)" />
                </div>

                <div class="col-xl-2 col-md-4">
                    <label class="form-label">Status</label>
                    <select class="form-select" name="OrderStatus">
                        @foreach (var status in statuses)
                        {
                            if (status == Model.EditTransaction.OrderStatus)
                            {
                                <option value="@status" selected>@status</option>
                            }
                            else
                            {
                                <option value="@status">@status</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-xl-2 col-md-4">
                    <label class="form-label">Payment</label>
                    <select class="form-select" name="PaymentMethod">
                        @foreach (var payment in payments)
                        {
                            if (payment == Model.EditTransaction.PaymentMethod)
                            {
                                <option value="@payment" selected>@payment</option>
                            }
                            else
                            {
                                <option value="@payment">@payment</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-xl-2 col-md-4">
                    <label class="form-label">Channel</label>
                    <select class="form-select" name="SalesChannel">
                        @foreach (var channel in channels)
                        {
                            if (channel == Model.EditTransaction.SalesChannel)
                            {
                                <option value="@channel" selected>@channel</option>
                            }
                            else
                            {
                                <option value="@channel">@channel</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-xl-1 col-md-2">
                    <label class="form-label">Delivery</label>
                    <input class="form-control" type="number" name="DeliveryDay" value="@Model.EditTransaction.DeliveryDay" />
                </div>

                <div class="col-xl-1 col-md-2">
                    <label class="form-label">Age</label>
                    <input class="form-control" type="number" name="CustomerAge" value="@Model.EditTransaction.CustomerAge" />
                </div>

                <div class="col-12 text-end mt-4">
                    <button type="submit" class="btn btn-dark-soft px-4">
                        <i class="bi bi-check2-circle me-1"></i>
                        Save Changes
                    </button>
                </div>
            </div>
        </form>
    </div>
}

<div class="advanced-filter-card">
    <div class="advanced-filter-inner">
        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
            <div>
                <h3 class="filter-title">Advanced Transaction Filters</h3>
                <p class="filter-subtitle">
                    Filter 2M+ sales records directly on SQL Server with Dapper-powered dynamic queries.
                </p>
            </div>

            <a href="/Sales/Index" class="btn btn-reset">
                <i class="bi bi-arrow-counterclockwise me-1"></i>
                Clear Filters
            </a>
        </div>

        <form method="get" asp-action="Index">
            <div class="row g-3">
                <div class="col-xl-2 col-md-4">
                    <label class="form-label">Transaction ID</label>
                    <input type="number"
                           class="form-control"
                           name="searchId"
                           placeholder="Example: 10025"
                           value="@Model.Filter.SearchId" />
                </div>

                <div class="col-xl-3 col-md-8">
                    <label class="form-label">Search Term</label>
                    <input type="text"
                           class="form-control"
                           name="searchTerm"
                           placeholder="Order, customer, email or product"
                           value="@Model.Filter.SearchTerm" />
                </div>

                <div class="col-xl-2 col-md-4">
                    <label class="form-label">City</label>
                    <select class="form-select" name="city">
                        <option value="">All Cities</option>
                        @foreach (var city in Model.FilterOptions.Cities)
                        {
                            if (city == Model.Filter.City)
                            {
                                <option value="@city" selected>@city</option>
                            }
                            else
                            {
                                <option value="@city">@city</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-xl-2 col-md-4">
                    <label class="form-label">Category</label>
                    <select class="form-select" name="category">
                        <option value="">All Categories</option>
                        @foreach (var category in Model.FilterOptions.Categories)
                        {
                            if (category == Model.Filter.Category)
                            {
                                <option value="@category" selected>@category</option>
                            }
                            else
                            {
                                <option value="@category">@category</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-xl-3 col-md-4">
                    <label class="form-label">Status</label>
                    <select class="form-select" name="status">
                        <option value="">All Statuses</option>
                        @foreach (var status in Model.FilterOptions.Statuses)
                        {
                            if (status == Model.Filter.Status)
                            {
                                <option value="@status" selected>@status</option>
                            }
                            else
                            {
                                <option value="@status">@status</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-xl-2 col-md-4">
                    <label class="form-label">Payment</label>
                    <select class="form-select" name="paymentMethod">
                        <option value="">All Payments</option>
                        @foreach (var payment in Model.FilterOptions.PaymentMethods)
                        {
                            if (payment == Model.Filter.PaymentMethod)
                            {
                                <option value="@payment" selected>@payment</option>
                            }
                            else
                            {
                                <option value="@payment">@payment</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-xl-2 col-md-4">
                    <label class="form-label">Channel</label>
                    <select class="form-select" name="salesChannel">
                        <option value="">All Channels</option>
                        @foreach (var channel in Model.FilterOptions.SalesChannels)
                        {
                            if (channel == Model.Filter.SalesChannel)
                            {
                                <option value="@channel" selected>@channel</option>
                            }
                            else
                            {
                                <option value="@channel">@channel</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-xl-2 col-md-4">
                    <label class="form-label">Start Date</label>
                    <input type="date"
                           class="form-control"
                           name="startDate"
                           value="@(Model.Filter.StartDate?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="col-xl-2 col-md-4">
                    <label class="form-label">End Date</label>
                    <input type="date"
                           class="form-control"
                           name="endDate"
                           value="@(Model.Filter.EndDate?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="col-xl-2 col-md-4">
                    <label class="form-label">Min Price</label>
                    <input type="number"
                           step="0.01"
                           class="form-control"
                           name="minPrice"
                           placeholder="0"
                           value="@(Model.Filter.MinPrice?.ToString(CultureInfo.InvariantCulture))" />
                </div>

                <div class="col-xl-2 col-md-4">
                    <label class="form-label">Max Price</label>
                    <input type="number"
                           step="0.01"
                           class="form-control"
                           name="maxPrice"
                           placeholder="50000"
                           value="@(Model.Filter.MaxPrice?.ToString(CultureInfo.InvariantCulture))" />
                </div>

                <div class="col-xl-2 col-md-4">
                    <label class="form-label">Page Size</label>
                    <select class="form-select" name="pageSize">
                        @if (Model.Filter.PageSize == 10)
                        {
                            <option value="10" selected>10 rows</option>
                        }
                        else
                        {
                            <option value="10">10 rows</option>
                        }

                        @if (Model.Filter.PageSize == 20)
                        {
                            <option value="20" selected>20 rows</option>
                        }
                        else
                        {
                            <option value="20">20 rows</option>
                        }

                        @if (Model.Filter.PageSize == 50)
                        {
                            <option value="50" selected>50 rows</option>
                        }
                        else
                        {
                            <option value="50">50 rows</option>
                        }

                        @if (Model.Filter.PageSize == 100)
                        {
                            <option value="100" selected>100 rows</option>
                        }
                        else
                        {
                            <option value="100">100 rows</option>
                        }
                    </select>
                </div>

                <div class="col-12 filter-actions mt-4">
                    <button type="submit" class="btn btn-dark-soft px-4">
                        <i class="bi bi-funnel-fill me-1"></i>
                        Apply Filters
                    </button>

                    <a href="/Sales/Index" class="btn btn-reset">
                        Reset
                    </a>
                </div>
            </div>
        </form>

        @if (Model.Filter.SearchId.HasValue ||
                !string.IsNullOrWhiteSpace(Model.Filter.SearchTerm) ||
                !string.IsNullOrWhiteSpace(Model.Filter.City) ||
                !string.IsNullOrWhiteSpace(Model.Filter.Category) ||
                !string.IsNullOrWhiteSpace(Model.Filter.Status) ||
                !string.IsNullOrWhiteSpace(Model.Filter.PaymentMethod) ||
                !string.IsNullOrWhiteSpace(Model.Filter.SalesChannel) ||
                Model.Filter.StartDate.HasValue ||
                Model.Filter.EndDate.HasValue ||
                Model.Filter.MinPrice.HasValue ||
                Model.Filter.MaxPrice.HasValue)
        {
            <div class="active-filter-strip">
                <span class="filter-chip">
                    <i class="bi bi-funnel-fill"></i>
                    Filtered Mode
                </span>

                @if (Model.Filter.SearchId.HasValue)
                {
                    <span class="filter-chip">ID: @Model.Filter.SearchId</span>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Filter.SearchTerm))
                {
                    <span class="filter-chip">Search: @Model.Filter.SearchTerm</span>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Filter.City))
                {
                    <span class="filter-chip">City: @Model.Filter.City</span>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Filter.Category))
                {
                    <span class="filter-chip">Category: @Model.Filter.Category</span>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Filter.Status))
                {
                    <span class="filter-chip">Status: @Model.Filter.Status</span>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Filter.PaymentMethod))
                {
                    <span class="filter-chip">Payment: @Model.Filter.PaymentMethod</span>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Filter.SalesChannel))
                {
                    <span class="filter-chip">Channel: @Model.Filter.SalesChannel</span>
                }
            </div>
        }
    </div>
</div>

<div class="panel-card">
    <div class="panel-header">
        <div class="row align-items-center g-3">
            <div class="col-xl-8">
                <h3 class="panel-title">Transaction Data</h3>
                <p class="panel-subtitle">
                    Only the active page is fetched from SQL Server. Dynamic filters are executed directly in SQL.
                </p>
            </div>

            <div class="col-xl-4 text-xl-end">
                <span class="matching-badge">
                    <i class="bi bi-database-check"></i>
                    @Model.TotalCount.ToString("N0") matching records
                </span>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table premium-table align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Order</th>
                    <th>Customer</th>
                    <th>Location</th>
                    <th>Product</th>
                    <th>Revenue</th>
                    <th>Status</th>
                    <th>Payment</th>
                    <th>Channel</th>
                    <th>Date</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model.Transactions)
                {
                    var statusClass = item.OrderStatus switch
                    {
                        "Completed" => "status-completed",
                        "Pending" => "status-pending",
                        "Cancelled" => "status-cancelled",
                        "Returned" => "status-returned",
                        _ => "status-processing"
                    };

                    <tr>
                        <td>
                            <span class="id-pill">#@item.SalesTransactionId</span>
                        </td>

                        <td>
                            <div class="customer-name">@item.OrderNumber</div>
                            <div class="muted-line">Qty: @item.Quantity</div>
                        </td>

                        <td>
                            <div class="customer-name">@item.CustomerFullName</div>
                            <div class="customer-email">@item.CustomerEmail</div>
                        </td>

                        <td>
                            <div class="customer-name">@item.City</div>
                            <div class="muted-line">@item.Country</div>
                        </td>

                        <td>
                            <div class="product-name">@item.ProductName</div>
                            <div class="category-text">@item.ProductCategory</div>
                        </td>

                        <td>
                            <div class="money-text">@item.TotalPrice.ToString("C")</div>
                            <div class="muted-line">Unit: @item.UnitPrice.ToString("C")</div>
                        </td>

                        <td>
                            <span class="status-badge @statusClass">@item.OrderStatus</span>
                        </td>

                        <td>@item.PaymentMethod</td>

                        <td>
                            <span class="customer-name">@item.SalesChannel</span>
                        </td>

                        <td>
                            <div class="customer-name">@item.OrderDate.ToString("dd MMM yyyy")</div>
                            <div class="muted-line">@item.DeliveryDay day delivery</div>
                        </td>

                        <td>
                            <div class="action-group">
                                <a href="@BuildFilterUrl(Model.CurrentPage, item.SalesTransactionId)"
                                   class="btn btn-outline-primary btn-table">
                                    <i class="bi bi-pencil-square"></i>
                                    Edit
                                </a>

                                <form asp-action="Delete" method="post">
                                    <input type="hidden" name="id" value="@item.SalesTransactionId" />
                                    <button type="submit"
                                            class="btn btn-outline-danger btn-table"
                                            onclick="return confirm('Are you sure you want to delete this transaction?')">
                                        <i class="bi bi-trash3"></i>
                                        Delete
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }

                @if (!Model.Transactions.Any())
                {
                    <tr>
                        <td colspan="11">
                            <div class="empty-state">
                                <div class="empty-icon">
                                    <i class="bi bi-database-x"></i>
                                </div>
                                <h5 class="fw-bold text-white">No transaction data found</h5>
                                <p class="mb-0">Try another filter combination or reset the filters.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Filter.SearchId.HasValue && Model.TotalPages > 1)
    {
        <div class="panel-header border-top border-bottom-0" style="border-top-color: rgba(148,163,184,.14) !important;">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="footer-meta">
                    Showing <strong class="text-white">@Model.Transactions.Count</strong> rows —
                    Page <strong class="text-white">@Model.CurrentPage.ToString("N0")</strong> of
                    <strong class="text-white">@Model.TotalPages.ToString("N0")</strong>
                </div>

                <nav>
                    <ul class="pagination mb-0">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="@BuildFilterUrl(Model.CurrentPage - 1)">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>

                        @for (var i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" href="@BuildFilterUrl(i)">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="@BuildFilterUrl(Model.CurrentPage + 1)">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    }
</div>