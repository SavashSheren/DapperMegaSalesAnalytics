<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dapper Mega Sales Analytics</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        :root {
            --dark: #0f172a;
            --dark-2: #111827;
            --muted: #64748b;
            --surface: #ffffff;
            --bg: #f4f7fb;
            --border: #e5e7eb;
            --primary: #2563eb;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: var(--bg);
            font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            color: #0f172a;
        }

        .app-shell {
            min-height: 100vh;
            display: flex;
        }

        .sidebar {
            width: 280px;
            background: linear-gradient(180deg, #0f172a 0%, #111827 100%);
            color: white;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            padding: 24px 18px;
            z-index: 20;
        }

        .brand-box {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 10px 26px;
            border-bottom: 1px solid rgba(255,255,255,.08);
            margin-bottom: 22px;
        }

        .brand-icon {
            width: 46px;
            height: 46px;
            border-radius: 16px;
            background: linear-gradient(135deg, #2563eb, #06b6d4);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            box-shadow: 0 16px 35px rgba(37,99,235,.35);
        }

        .brand-title {
            font-size: 17px;
            font-weight: 800;
            line-height: 1.1;
        }

        .brand-subtitle {
            font-size: 12px;
            color: #94a3b8;
            margin-top: 4px;
        }

        .nav-section-title {
            color: #94a3b8;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
            margin: 24px 12px 10px;
        }

        .side-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 14px;
            border-radius: 14px;
            color: #cbd5e1;
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            margin-bottom: 8px;
            transition: .2s;
        }

            .side-link:hover {
                color: white;
                background: rgba(255,255,255,.08);
            }

            .side-link.active {
                color: white;
                background: linear-gradient(135deg, #2563eb, #1d4ed8);
                box-shadow: 0 14px 28px rgba(37,99,235,.25);
            }

        .sidebar-footer {
            position: absolute;
            bottom: 20px;
            left: 18px;
            right: 18px;
            background: rgba(255,255,255,.06);
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 18px;
            padding: 16px;
        }

            .sidebar-footer .small {
                color: #94a3b8;
            }

        .main-area {
            margin-left: 280px;
            width: calc(100% - 280px);
            min-height: 100vh;
        }

        .topbar {
            height: 76px;
            background: rgba(255,255,255,.86);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 34px;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .topbar-title {
            font-size: 15px;
            color: var(--muted);
            font-weight: 600;
        }

        .topbar strong {
            color: #0f172a;
        }

        .topbar-badge {
            background: #ecfdf5;
            color: #047857;
            border: 1px solid #a7f3d0;
            padding: 8px 12px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 700;
        }

        .content-wrapper {
            padding: 32px 34px;
        }

        .content-inner {
            width: 100%;
            max-width: 1540px;
            margin: 0 auto;
        }

        .btn {
            font-weight: 700;
        }

        .table {
            font-size: 14px;
        }

            .table > :not(caption) > * > * {
                padding: 16px 14px;
            }

        @@media (max-width: 992px) {
            .sidebar {
                position: relative;
                width: 100%;
                min-height: auto;
            }

            .app-shell {
                display: block;
            }

            .main-area {
                margin-left: 0;
                width: 100%;
            }

            .sidebar-footer {
                position: relative;
                bottom: auto;
                left: auto;
                right: auto;
                margin-top: 20px;
            }

            .topbar {
                padding: 0 18px;
            }

            .content-wrapper {
                padding: 22px 16px;
            }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    @{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    }

    <div class="app-shell">
        <aside class="sidebar">
            <div class="brand-box">
                <div class="brand-icon">
                    <i class="bi bi-bar-chart-line-fill"></i>
                </div>
                <div>
                    <div class="brand-title">Mega Sales</div>
                    <div class="brand-subtitle">Dapper Analytics</div>
                </div>
            </div>

            <div class="nav-section-title">Analytics</div>

            <a class="side-link @(controller == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-speedometer2"></i>
                Dashboard
            </a>

            <a class="side-link @(controller == "Sales" ? "active" : "")" asp-controller="Sales" asp-action="Index">
                <i class="bi bi-database-fill"></i>
                Sales Transactions
            </a>

            <div class="nav-section-title">System</div>

            <a class="side-link" href="https://github.com/SavashSheren/DapperMegaSalesAnalytics" target="_blank">
                <i class="bi bi-github"></i>
                GitHub Repository
            </a>

            <div class="sidebar-footer">
                <div class="fw-bold mb-1">Large Dataset Mode</div>
                <div class="small">Server-side paging with Dapper and SQL Server.</div>
            </div>
        </aside>

        <main class="main-area">
            <header class="topbar">
                <div>
                    <div class="topbar-title">Project Case / <strong>@ViewData["Title"]</strong></div>
                </div>

                <div class="topbar-badge">
                    <i class="bi bi-lightning-charge-fill me-1"></i>
                    Dapper Powered
                </div>
            </header>

            <section class="content-wrapper">
                <div class="content-inner">
                    @RenderBody()
                </div>
            </section>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>